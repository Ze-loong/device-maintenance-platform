# 后端配置模板，不填写真实凭据；首次本地配置可通过 deploy/init_local.py 生成。
# 环境名称，目前主要用于保留环境区分配置。
APP_ENV=dev
# 数据库连接格式：驱动、账号、占位密码、Compose 服务名、容器端口、数据库名。
DATABASE_URL=postgresql+psycopg://iot:change_me@postgres:5432/iot_platform
# 容器通过 Compose 服务名连接 Broker。
MQTT_HOST=emqx
# MQTT TCP 端口，不是管理控制台端口。
MQTT_PORT=1883
# 平台账号，用于订阅事件和发布预测。
MQTT_USERNAME=platform
# 密码占位，初始化脚本生成与 Broker 初始用户表一致的密码。
MQTT_PASSWORD=change_me
# 模型凭据留空，初始化时从工作区根配置读取。
DEEPSEEK_API_KEY=
# OpenAI 兼容接口的服务地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 请求使用的模型标识。
LLM_MODEL=deepseek-v4-flash
# 客户端超时秒数；重试与退避等待可能令总耗时更长。
LLM_TIMEOUT_SECONDS=20
