# 独立模拟器配置模板；容器通过 Compose 服务名连接 MQTT 服务。
MQTT_HOST=emqx
# MQTT 消息端口。
MQTT_PORT=1883
# 模拟网关使用独立账号，与平台账号分开。
MQTT_USERNAME=simulator
# 仅为占位值；首次初始化生成随机密码并同步到 Broker 用户表。
MQTT_PASSWORD=change_me
# 平台 REST API，用于模拟网关注册家庭和设备。
API_BASE_URL=http://platform:8000
ADMIN_USERNAME=admin
# 仅为占位值，真实密码放 simulator/.env，禁止提交。
ADMIN_PASSWORD=change_me
